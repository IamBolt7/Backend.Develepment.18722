<%- include("partials/header", { title: "Articles" }) %>

<section class="hero">
    <div>
        <p class="eyebrow">Content workspace</p>
        <h1>Ideas, notes & articles.</h1>
        <p class="lead">A simple place to publish, manage and read your writing.</p>
    </div>
    <a href="/posts/new" class="button">Create article <span aria-hidden="true">→</span></a>
</section>

<section class="section-heading">
    <div><h2>Latest articles</h2><p><%= posts.length %> published <%= posts.length === 1 ? "article" : "articles" %></p></div>
</section>

<% if (posts.length === 0) { %>
    <section class="empty-state">
        <div class="empty-icon">✦</div><h2>No articles yet</h2><p>Create your first article to get started.</p>
        <a href="/posts/new" class="button">Create article</a>
    </section>
<% } else { %>
    <div class="post-grid">
        <% posts.forEach((post, index) => { %>
            <article class="post-card <%= index === 0 ? 'featured' : '' %>">
                <div class="card-top"><span class="article-number"><%= String(index + 1).padStart(2, '0') %></span><span class="read-label">Article</span></div>
                <h3><a href="/posts/<%= post._id %>"><%= post.title %></a></h3>
                <p class="meta">By <strong><%= post.author %></strong><span class="meta-dot">·</span><time datetime="<%= post.createdAt.toISOString() %>"><%= formatDate(post.createdAt) %></time></p>
                <a class="card-arrow" href="/posts/<%= post._id %>" aria-label="Read <%= post.title %>">↗</a>
            </article>
        <% }) %>
    </div>
<% } %>

<%- include("partials/footer") %>
