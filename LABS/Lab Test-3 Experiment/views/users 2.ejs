<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Users List</title><link rel="stylesheet" href="/style.css"></head><body><main class="card"><h1>Users List</h1><div style="overflow-x:auto"><table><thead><tr><th>ID</th><th>Name</th><th>Email</th></tr></thead><tbody><% users.forEach(function(user) { %><tr><td><%= user.id %></td><td><%= user.name %></td><td><%= user.email %></td></tr><% }); %></tbody></table></div><% if (users.length === 0) { %><p>No users found.</p><% } %><p><a href="/">Back to Lab Home</a></p></main></body></html>
