<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="container">
    <section class="hero">
      <span class="badge">Experiment 12</span>
      <h1>Node.js, Express.js & EJS Templating</h1>
      <p>A working lab implementation covering Express responses, route/query parameters, POST data and dynamic EJS rendering.</p>
    </section>

    <section class="card">
      <h2>Experiment Topics</h2>
      <div class="topics">
        <% topics.forEach(topic => { %><span><%= topic %></span><% }) %>
      </div>
    </section>

    <section class="grid">
      <article class="card"><h2>Response Methods</h2><a href="/text">Plain Text</a><a href="/html">HTML</a><a href="/json">JSON</a><a href="/status">Status 201</a></article>
      <article class="card"><h2>URL Parameters</h2><a href="/user/123">/user/123</a><a href="/product/electronics/456">/product/electronics/456</a></article>
      <article class="card"><h2>Query Parameters</h2><a href="/search?q=nodejs&page=2&limit=20">Search Example</a><a href="/calculate?num1=10&num2=5&operation=add">Calculator Example</a></article>
    </section>

    <section class="card">
      <h2>EJS + POST Data Demo</h2>
      <form method="POST" action="/feedback">
        <label>Name<input name="name" required placeholder="Your name"></label>
        <label>Message<textarea name="message" required placeholder="Enter feedback"></textarea></label>
        <button type="submit">Submit Feedback</button>
      </form>
    </section>

    <section class="card api">
      <h2>POST API Testing</h2>
      <p><strong>POST /register</strong> JSON: <code>{"username":"john","email":"john@example.com","password":"pass123"}</code></p>
      <p><strong>POST /login</strong> JSON: <code>{"email":"test@example.com","password":"password123"}</code></p>
    </section>
  </main>
</body>
</html>
