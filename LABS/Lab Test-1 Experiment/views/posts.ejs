<!DOCTYPE html>
<html>
<head>
    <title>Simple CMS</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Simple CMS</h1>

    <a href="/posts/new">Create New Post</a>

    <h2>All Posts</h2>

    <% posts.forEach(post => { %>

        <div class="post">

            <h3>
                <a href="/posts/<%= post._id %>">
                    <%= post.title %>
                </a>
            </h3>

            <p>Author: <%= post.author %></p>

            <p>
                Created:
                <%= post.createdAt.toLocaleString() %>
            </p>

        </div>

    <% }) %>

</body>
</html>